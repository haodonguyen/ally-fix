# =============================================================================
# AllyFix — environment template
# Copy this file to `.env` and fill in the values. NEVER commit a real `.env`.
# This project is bring-your-own-key: no API keys are ever hardcoded or logged.
# =============================================================================

# --- Core services ----------------------------------------------------------
# PostgreSQL connection string (Drizzle). Matches the docker-compose `postgres` service.
DATABASE_URL=postgres://allyfix:allyfix@localhost:5432/allyfix

# Redis connection string (BullMQ queue + result cache). Matches docker-compose `redis`.
REDIS_URL=redis://localhost:6379

# --- Web app ----------------------------------------------------------------
# Public base URL of the web app (used for shareable report links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- LLM provider selection -------------------------------------------------
# Which provider the LLM layer uses. One of: ollama | groq | gemini
# `ollama` is the default for local/self-hosted runs and needs no API key.
LLM_PROVIDER=ollama

# Ollama (local, free). Only used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Groq (bring-your-own-key). Only used when LLM_PROVIDER=groq.
# User-supplied keys live only in-session; they are never written to the DB.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini (bring-your-own-key). Only used when LLM_PROVIDER=gemini.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# How long a cached LLM analysis stays valid, in seconds (default 30 days).
# Results are cached in Redis by provider + model + rule + HTML pattern.
LLM_CACHE_TTL_SECONDS=2592000

# --- LLM failure policy (worker) --------------------------------------------
# All optional; the defaults below are what the worker uses when these are unset.

# Deadline for a single LLM request, in ms. Generous on purpose: it exists to
# catch a hung connection, not to police a slow-but-working local model.
LLM_TIMEOUT_MS=60000

# Extra attempts after the first, on a retryable failure. 0 disables retrying.
# Backoff is exponential with full jitter, so concurrent workers don't retry in
# lockstep and re-create the burst that rate-limited them.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_MS=800

# Outbound rate limit (token bucket), in requests per minute. 0 = unlimited.
# Leave this COMMENTED OUT to get the provider-dependent default: 0 for Ollama
# (local, no quota to protect) and 30 for a hosted provider, whose free tier does
# enforce a per-minute cap. Setting it blank is the same as leaving it out.
# LLM_REQUESTS_PER_MINUTE=30

# Circuit breaker: after this many consecutive provider failures, the worker
# stops calling the provider for LLM_BREAKER_RESET_MS and then probes once.
# Without it, one unreachable provider turns every rule group into a full retry
# chain. 0 disables the breaker. A malformed model *response* never counts here —
# that is the model being unhelpful, not the provider being down.
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_RESET_MS=30000

# --- Cost / rate limiting (hosted demo only) --------------------------------
# Per-IP daily audit limit for the maintainer-hosted free tier. 0 = unlimited (self-host).
DAILY_AUDIT_LIMIT_PER_IP=0

# --- Worker lifecycle -------------------------------------------------------
# How long in-flight scans get to finish after a SIGTERM, in ms. Kept under the
# ~30s most platforms allow between SIGTERM and SIGKILL, so the worker exits on
# its own terms instead of being killed mid-write.
SHUTDOWN_GRACE_MS=20000

# A `running` audit older than this was abandoned by a worker that died, and is
# swept into `failed` so the report page stops polling a scan that isn't coming.
# Comfortably above SCAN_TIMEOUT_MS plus the LLM pass. Queued audits are never
# swept: in the on-demand demo they legitimately wait for the worker to come up.
STALE_AUDIT_AFTER_MS=900000
STALE_SWEEP_INTERVAL_MS=300000

# --- Logging ----------------------------------------------------------------
# Minimum level to emit: debug | info | warn | error.
# Defaults to debug outside production, info in production.
LOG_LEVEL=debug

# json for a log collector, pretty for a human watching a terminal.
# Defaults to pretty outside production, json in production.
LOG_FORMAT=pretty

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development

# Max time the worker waits for a page to load before failing the scan, in ms.
SCAN_TIMEOUT_MS=30000
